diff --git a/vendor/loader/tests/host-loader.spec.ts b/vendor/loader/tests/host-loader.spec.ts
new file mode 100644
index 0000000..70e6eb1
--- /dev/null
+++ b/vendor/loader/tests/host-loader.spec.ts
@@ -0,0 +1,53 @@
+/**
+ * M-0 tests: the host module-import seam isolates plugin imports from Node
+ * internals, so the Node adapter must import (a) URL-relative paths against
+ * the tree base URL and (b) bare package specifiers as the tree's own
+ * consumer would, and a foreign host may bind its own `HostModuleLoader`.
+ * @module @deepseek-ai/cordis-plugin-loader/host-loader.spec
+ */
+
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { NodeHostModuleLoader } from '../src/host-loader.ts'
+
+describe('NodeHostModuleLoader (fallback path, no internal loader)', () => {
+  it('imports a relative specifier against the tree base URL', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'host-loader-'))
+    try {
+      writeFileSync(join(dir, 'fixture.mjs'), 'export default { ok: true, tag: "relative" }\n')
+      const loader = new NodeHostModuleLoader(undefined)
+      const namespace = await loader.import('./fixture.mjs', pathToFileURL(dir + '/').href, {})
+      expect(namespace.default).toEqual({ ok: true, tag: 'relative' })
+    } finally {
+      rmSync(dir, { recursive: true, force: true })
+    }
+  })
+
+  it('falls back to createRequire resolution for bare specifiers', async () => {
+    const loader = new NodeHostModuleLoader(undefined)
+    const namespace = await loader.import('@deepseek-ai/cosmokit', pathToFileURL(join(process.cwd(), 'vendor/loader') + '/').href, {})
+    expect(namespace).toBeTypeOf('object')
+  })
+
+  it('forwards to the internal loader exactly when present (semantics preserved)', async () => {
+    const calls: unknown[][] = []
+    const internal = { import: async (...args: unknown[]) => { calls.push(args); return { marker: true } } }
+    const loader = new NodeHostModuleLoader(internal as never)
+    const namespace = await loader.import('some/pkg', 'file:///base/', {})
+    expect(namespace).toEqual({ marker: true })
+    expect(calls).toHaveLength(1)
+    expect(calls[0]).toEqual(['some/pkg', 'file:///base/', {}])
+  })
+})
+
+describe('host seam on Loader (wiring)', () => {
+  it('constructs the Node adapter when the internal loader is reachable', async () => {
+    // Loader construction needs a live Context; wiring is covered by the
+    // entry tree suites. This guard pins the seam types only.
+    const { NodeHostModuleLoader: N } = await import('../src/host-loader.ts') as never
+    expect(N).toBeTypeOf('function')
+  })
+})
