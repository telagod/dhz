diff --git a/vendor/loader/src/host-loader.ts b/vendor/loader/src/host-loader.ts
new file mode 100644
index 0000000..be03802
--- /dev/null
+++ b/vendor/loader/src/host-loader.ts
@@ -0,0 +1,59 @@
+/**
+ * The one seam a host runtime supplies to the plugin tree: how a loader entry
+ * module is imported from a specifier. Everything else in `Loader` is
+ * runtime-agnostic; only this interface is host-specific.
+ *
+ * This is the M-0 injection point for the Zig+quickjs-ng host: the Zig host
+ * provides a `HostModuleLoader` backed by the quickjs-ng module linker, while
+ * the Node host keeps its exact semantics through `NodeHostModuleLoader`.
+ * Nothing outside `host-loader.ts` needs to know which host is running.
+ *
+ * @module @deepseek-ai/cordis-plugin-loader/host-loader
+ */
+
+import { createRequire } from 'node:module'
+import { pathToFileURL } from 'node:url'
+import type { ModuleLoader } from './internal.ts'
+
+/**
+ * Host module-import seam. `baseUrl` is the entry tree's configured URL and
+ * the resolution anchor for relative specifiers; `attributes` carries the
+ * import attributes of the importing entry (the old `assert` clause).
+ */
+export interface HostModuleLoader {
+  import(specifier: string, baseUrl: string, attributes: ImportAttributes): Promise<any>
+}
+
+/**
+ * Node adapter: prefers Node's internal ESM `ModuleLoader` for exact
+ * semantics (bare specifiers resolved from `baseUrl`, package `exports`
+ * conditions, module-job caching), and falls back to plain dynamic
+ * `import()` when the internal loader is unavailable — a foreign runtime,
+ * or a hardened Node without the require-builtin addon.
+ */
+export class NodeHostModuleLoader implements HostModuleLoader {
+  constructor(public readonly internal: ModuleLoader | undefined) {}
+
+  async import(specifier: string, baseUrl: string, attributes: ImportAttributes): Promise<any> {
+    if (this.internal) {
+      // Exact legacy path: Node's internal ESM loader, resolved against the
+      // entry tree's base URL.
+      return await this.internal.import(specifier, baseUrl, attributes)
+    }
+    if (specifier.startsWith('.')) {
+      // URL-relative path: resolve against the entry tree's base URL.
+      return await import(/* @vite-ignore */ new URL(specifier, baseUrl).href)
+    }
+    try {
+      // Bare/`file:` specifier: resolve as the entry tree's own consumer
+      // would, so a tree under a profile directory sees that directory's
+      // modules (import conditions apply; ESM-only exports are fine).
+      const resolved = import.meta.resolve(specifier, baseUrl)
+      return await import(/* @vite-ignore */ resolved)
+    } catch {
+      const requireFrom = createRequire(baseUrl)
+      const resolved = requireFrom.resolve(specifier)
+      return await import(/* @vite-ignore */ pathToFileURL(resolved).href)
+    }
+  }
+}
