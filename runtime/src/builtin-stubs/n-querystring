export function escape(s) { return encodeURIComponent(s); } export function unescape(s) { return decodeURIComponent(s); } export function stringify(o) { return Object.entries(o || {}).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&'); } export function parse(s) { const o = {}; for (const kv of String(s || '').split('&')) { const [k, v] = kv.split('='); if (k) o[decodeURIComponent(k)] = decodeURIComponent(v || ''); } return o; }